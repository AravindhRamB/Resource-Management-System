# Logs
# ========================
logs/
*.log
*.log.*

# ========================
# Runtime data
# ========================
pids/
*.pid
*.seed
*.pid.lock

# ========================
# Coverage & test
# ========================
coverage/
*.lcov

# ========================
# Build directories
# ========================
dist/
build/
tmp/
temp/

# ========================
# System files
# ========================
.DS_Store         # macOS
Thumbs.db         # Windows
ehthumbs.db       # Windows
Icon?
Desktop.ini

