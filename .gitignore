# ========================
# Node.js
# ========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
.env
.env.*       # For multiple environment configs like .env.dev
!.env.test   # Keep test environment file in repo (without sensitive data)

